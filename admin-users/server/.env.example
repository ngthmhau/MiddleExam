# Only the server receives this URI. The mobile app must NEVER contain it.
MONGODB_URI=
PORT=4000
ADMIN_EMAIL=admin@example.com
# Run npm run setup to generate a password hash and JWT secret automatically.
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# Expo web dev origins; native apps are not subject to browser CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
